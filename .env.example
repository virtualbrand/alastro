# Template de variáveis de ambiente.
# Copie para .env.local e preencha. NUNCA comite valores reais —
# .env.local está no .gitignore.
#
# Em produção, as mesmas variáveis devem ser cadastradas na Vercel
# (Project Settings > Environment Variables).

# ---------------------------------------------------------------------------
# E-mail transacional (formulários de contato e trabalhe conosco)
# ---------------------------------------------------------------------------

# Chave da API da Brevo. Somente servidor.
BREVO_API_KEY=

# Caixa que recebe os envios dos formulários.
CONTACT_EMAIL=contato@example.com

# ---------------------------------------------------------------------------
# Supabase — autenticação e dados do painel
# Painel > Project Settings > API
# ---------------------------------------------------------------------------

# URL do projeto. Ex.: https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Chave publicável (projetos novos: "publishable", sb_publishable_...;
# projetos antigos: "anon", um JWT). Exposta ao navegador de propósito —
# quem protege os dados é a RLS, não o sigilo desta chave.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Chave secreta / service_role. SOMENTE no servidor.
# Ignora RLS por completo: nunca com prefixo NEXT_PUBLIC_, nunca importada
# em componente cliente. Preencha só se houver operação administrativa.
SUPABASE_SECRET_KEY=

# URL base do site, usada pela Supabase Auth nos links de redirecionamento
# (confirmação de e-mail, recuperação de senha).
# Local: http://localhost:3000 | Produção: https://somosalastro.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Segredo do Vercel Cron que mantém a Supabase ativa (app/api/keep-alive).
# A Vercel o envia como "Authorization: Bearer <valor>". Gere com:
# openssl rand -hex 32
CRON_SECRET=

# ---------------------------------------------------------------------------
# Supabase — acesso direto ao Postgres (opcional)
# Só para CLI, migrations ou clientes SQL externos. O app não usa.
# Painel > Database > Settings (senha) e Connect (strings de conexão)
#
# Copie as strings prontas do painel: se montar na mão, caracteres
# reservados na senha (# & ? @ / : espaço) exigem percent-encoding.
# ---------------------------------------------------------------------------

# SUPABASE_PROJECT_REF=
# SUPABASE_DB_PASSWORD=
# DATABASE_URL=
# DIRECT_URL=
